{
	"name": "obsidian-whatsapp-desktop-notes",
	"version": "0.2.0",
	"description": "Sync your WhatsApp Desktop chats into your vault. macOS only. / Sincroniza suas conversas do WhatsApp Desktop com o seu vault. Somente macOS.",
	"main": "main.js",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck && tsc -noEmit -skipLibCheck -p tests",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"licenses": "node scripts/check-licenses.mjs",
		"check": "npm run typecheck && npm run lint && npm run coverage && npm run licenses",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"install:vault": "node scripts/install.mjs",
		"coverage": "vitest run --coverage",
		"bench": "vitest run tests/bench"
	},
	"keywords": [
		"obsidian",
		"whatsapp",
		"sqlite"
	],
	"author": "Guilherme Schroder",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^4.1.12",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"obsidian": "1.14.4",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^4.1.12"
	}
}
